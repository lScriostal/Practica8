<Page x:Class="Practica8.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica8.Pages"
      mc:Ignorable="d" 
      Background="Cornsilk"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Выбор модели и типа двигателя"
                   FontSize="26"
                   Foreground="Coral"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,30">
            <TextBlock Text="Выбор модели машины"
                       FontSize="18"
                       Foreground="Coral"
                       Margin="0,0,0,10"/>
            <ListBox x:Name="ListBox1"
                     Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,30">
            <TextBlock Text="Выбор модели машины"
                       FontSize="18"
                       Foreground="Coral"
                       Margin="0,0,0,10"/>  
            <ListBox x:Name="ListBox2"
                     Height="100"/>
        </StackPanel>

        <Button x:Name="EngineButton"
                Grid.Row="3"
                Content="Продолжить"
                Width="135"
                Height="35"
                HorizontalAlignment="Center"
                Click="EngineButton_OnClick"/>

    </Grid>
</Page>
