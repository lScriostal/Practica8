<Page x:Class="Practica8.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica8.Pages"
      mc:Ignorable="d" 
      Background="Cornsilk"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Выбор цвета и дополнительных опций"
                   FontSize="26"
                   Foreground="Coral"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,30">
            <TextBlock Text="Выбор цвета машины"
                       FontSize="18"
                       Foreground="Coral"
                       Margin="0,0,0,10"/>
            <ListBox x:Name="ListBox1"
                     Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,30">
            <TextBlock Text="Выбор дополнительных опций"
                       FontSize="18"
                       Foreground="Coral"
                       Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkBasic" Content="Обычная версия" Margin="0,5"/>
            <CheckBox x:Name="ChkMedium" Content="Средняя версия" Tag="20000" Margin="0,5"/>
            <CheckBox x:Name="ChkMax" Content="Максимальная версия" Tag="50000" Margin="0,5"/>
            <CheckBox x:Name="ChkRoof" Content="Панорамная крыша" Tag="30000" Margin="0,5"/>
            <CheckBox x:Name="ChkAutoPilot" Content="Автопилот" Tag="70000" Margin="0,5"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Button x:Name="ColorButton"
                Content="Продолжить"
                Width="135"
                Height="35"
                HorizontalAlignment="Right"
                Click="ColorButton_OnClick"/>

            <Button x:Name="ColorEndButton"
                Content="Назад"
                Width="135"
                Height="35"
                HorizontalAlignment="Left"
                Click="ColorEndButton_OnClick"/>
        </Grid>

    </Grid>
</Page>
