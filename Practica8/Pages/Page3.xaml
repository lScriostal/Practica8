<Page x:Class="Practica8.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica8.Pages"
      mc:Ignorable="d" 
      Background="Cornsilk"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выбор цвета и дополнительных опций"
            Grid.Row="0"
            FontSize="30"
            HorizontalAlignment="Center"
            Foreground="Coral"/>
        <TextBlock Text="Выбор цвета машины"
            FontSize="20" 
            Margin="54,67,-54,-67"
            Foreground="Coral"/>
        <ListBox x:Name="ListBox1" 
          Margin="54,100,54,241"/>
        <TextBlock Text="Выбор дополнительных опций"
            FontSize="20" 
            Margin="54,225,-54,-225"
            Foreground="Coral"/>
        <ListBox x:Name="ListBox2" 
          Margin="54,261,54,80"/>
        <Button x:Name="ColorButton"
             Margin="558,387,54,10"
             Content="Продолжить"
             FontSize="20"
             Click="ColorButton_OnClick"/>
        <Button x:Name="ColorEndButton"
             Margin="54,387,558,10"
             Content="Назад"
             FontSize="20"
             Click="ColorEndButton_OnClick"/>
    </Grid>
</Page>
