<Page x:Class="Practica8.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica8.Pages"
      mc:Ignorable="d" 
      Background="Cornsilk"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page5"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройка и расчёт кредита" 
                   FontSize="26" Foreground="Coral" HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1" Width="500" HorizontalAlignment="Center">
            <TextBlock Text="Первоначальный взнос:" FontSize="18" Foreground="Coral"/>
            <TextBlock x:Name="TxtInitialPercent" Text="20%" FontSize="16" Margin="0,5,0,0"/>
            <Slider x:Name="SliderInitial" Minimum="0" Maximum="100" Value="20"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="TxtInitialSum" Text="Сумма взноса: 0 руб." FontSize="16" Margin="0,0,0,20"/>

            <TextBlock Text="Срок кредита (месяцев):" FontSize="18" Foreground="Coral"/>
            <TextBlock x:Name="TxtTermMonths" Text="12 мес." FontSize="16" Margin="0,5,0,0"/>
            <Slider x:Name="SliderTerm" Minimum="12" Maximum="96" Value="12"
                    TickFrequency="12" IsSnapToTickEnabled="True" 
                    ValueChanged="Slider_ValueChanged"/>

            <Separator Margin="0,30"/>

            <TextBlock Text="Сумма кредита:" FontSize="18" Margin="0,5"/>
            <TextBlock x:Name="TxtCreditSum" Text="0 руб." FontSize="18" Margin="0,0,0,15"/>

            <TextBlock Text="Ежемесячный платёж:" FontSize="18" Margin="0,5"/>
            <TextBlock x:Name="TxtMonthlyPayment" Text="0 руб." FontSize="24" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Назад" Width="135" Height="35" HorizontalAlignment="Left" Click="BackButton_OnClick"/>
            <Button Content="Оформить заявку" Width="150" Height="35" HorizontalAlignment="Right" Click="NextButton_OnClick"/>
        </Grid>
    </Grid>
</Page>
