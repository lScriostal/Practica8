<Page x:Class="Practica8.Pages.Page6"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica8.Pages"
      mc:Ignorable="d" 
      Background="Cornsilk"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Оформление заявки" FontSize="26" Foreground="Coral" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Center">
            <TextBlock Text="Ваше имя:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtName" FontSize="16" Padding="5" 
                     TextChanged="Input_TextChanged"/>

            <TextBlock Text="Телефон (только цифры):" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtPhone" FontSize="16" Padding="5" 
                     TextChanged="Input_TextChanged"/>

            <TextBlock Text="Email:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtEmail" FontSize="16" Padding="5" 
                     TextChanged="Input_TextChanged"/>

            <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Назад" Width="135" Height="35" HorizontalAlignment="Left" Click="BackButton_OnClick"/>

            <Button x:Name="BtnSubmit" Content="Отправить заявку" Width="150" Height="35" 
                    HorizontalAlignment="Right" Click="SubmitButton_OnClick" 
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
